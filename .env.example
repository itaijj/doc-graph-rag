# ── LLM (OpenAI) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_TIMEOUT=120

# ── PostgreSQL (relational + pgvector) ──────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=docgraph
POSTGRES_USER=docgraph
POSTGRES_PASSWORD=docgraph

# ── Neo4j (graph) ───────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphpassword

# ── Ingestion ───────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_ENTITIES_PER_CHUNK=15

# ── Agent ───────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=3
VECTOR_SEARCH_TOP_K=6

# ── API ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
